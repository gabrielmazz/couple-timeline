{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couple-timeline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "READ_URL_TTL_SECONDS": "3600",
    "FIREBASE_PROJECT_ID": "couple-timeline-3eae7"
  },
  "r2_buckets": [
    {
      "binding": "TIMELINE_IMAGES",
      "bucket_name": "couple-timeline-images",
      "remote": true
    }
  ],
  "secrets": {
    "required": [
      "IMAGE_SIGNING_SECRET",
      "ALLOWED_ORIGINS"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
